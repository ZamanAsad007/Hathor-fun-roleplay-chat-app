{
  "name": "hathor",
  "version": "0.1.1",
  "private": true,
  "description": "Hathor roleplay chat application backend & client",
  "scripts": {
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy chat --no-verify-jwt",
    "secrets:set": "supabase secrets set --env-file .env",
    "secrets:rotate": "./scripts/rotate-secret.sh",
    "build:apk": "cd app && npx eas-cli build -p android --profile preview",
    "build:configure": "cd app && npx eas-cli build:configure"
  }
}
